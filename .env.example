# Source des données
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv

# Ce qu'on télécharge
DEPARTEMENTS=93
ANNEES=2023,2024,2025

# Data lake (Silo, compatible S3)
